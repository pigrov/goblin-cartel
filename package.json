{
  "name": "goblin-cartel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:admin": "pnpm --filter @goblin-cartel/admin dev",
    "dev:backend": "pnpm --filter @goblin-cartel/backend dev",
    "dev:game": "pnpm --filter @goblin-cartel/game-client dev",
    "encoding:check": "powershell -ExecutionPolicy Bypass -File tools/check-text-encoding.ps1 .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
